extends "res://tests/phone_world_repair_test.gd"
const Economy=preload("res://scripts/core/expedition_economy.gd")
func test_guards():
	var s=State.new(false)
	s.start_run("warrior","expedition",717)
	s._replace_enemy_actors([])
	s.player_pos=s.expedition_markers.merchant
	s._update_exploration(true)
	check(Economy.at_merchant(s),"safe generated merchant remains accessible through context")
	check(s.interaction_label()=="TRADE","ordinary merchant context label retained")
	s.player_action=s._action("repack",0.32,Vector2.ZERO)
	check(not Economy.at_merchant(s) and Economy.merchant_denial(s).contains("action"),"merchant readiness restriction and reason")
	s.player_action=s._idle_action()
	s._add_projectile({"kind":"player_arrow","pos":s.player_pos,"vel":Vector2.RIGHT,"radius":8,"damage":10,"source_id":0,"layer":s.current_layer,"misdirected":false})
	check(not Economy.at_merchant(s) and Economy.merchant_denial(s).contains("projectile"),"merchant projectile restriction and reason")
	s.projectiles.clear()
	s._add_hazard({"kind":"fire","source_id":99,"pos":s.player_pos,"radius":100,"elapsed":0.0,"duration":1.0,"layer":s.current_layer})
	check(not Economy.at_merchant(s) and Economy.merchant_denial(s).contains("hazard"),"merchant hostile hazard restriction and reason")
	s.hazards.clear()
	s.player_pos+=Vector2(150,0)
	check(not Economy.at_merchant(s) and Economy.merchant_denial(s).contains("closer"),"merchant strict 150 distance boundary retained")
	s.player_pos=s.expedition_markers.merchant
	s.consumable_slots=s._empty_consumable_slots()
	s._add_pickup({"id":"wrong_layer","item_id":"firebomb","count":1,"pos":s.player_pos,"layer":"elsewhere"})
	check(not s.request_collect_pickup("wrong_layer",false),"specific collection enforces layer")
	s._add_pickup({"id":"too_far","item_id":"firebomb","count":1,"pos":s.player_pos+Vector2(113,0),"layer":s.current_layer})
	check(not s.request_collect_pickup("too_far",false),"specific collection enforces world range")
	s._add_pickup({"id":"selected","item_id":"firebomb","count":2,"pos":s.player_pos,"layer":s.current_layer})
	check(s.request_collect_pickup("selected",false),"specific collection accepts in-range item")
	check(not s.request_collect_pickup("selected",false),"repeated tap during repack cannot duplicate collection")
	check(s.pickup_by_id("selected").is_empty() and s.consumable_slots[0].count==2,"exact stack transferred once")
	s.player_action=s._idle_action()
	for i in range(s.consumable_slots.size()): s.consumable_slots[i]={"id":"trail_ration","count":3}
	s._add_pickup({"id":"full_belt","item_id":"firebomb","count":1,"pos":s.player_pos,"layer":s.current_layer})
	check(not s.request_collect_pickup("full_belt",false) and s.pending_pickup.id=="full_belt","full belt retains exact selected pending identity")
	check(not s.request_collect_pickup("too_far",false) and s.pending_pickup.id=="full_belt","second selection cannot overwrite pending choice")
	check(s.replace_pending_pickup(0,false),"normal pending replacement succeeds")
	check(s.pickup_by_id("full_belt").is_empty() and s.consumable_slots[0].id=="firebomb","replacement removes correct item once")
	check(s.world_pickups.any(func(p):return String(p.id).begins_with("discard_") and int(p.count)==3),"displaced stack preserved on ground")
	s.player_action=s._idle_action()
	s._add_pickup({"id":"layer_gear","item_id":"trailcoat","count":1,"pos":s.player_pos,"layer":"elsewhere"})
	check(not Economy.equip(s,"layer_gear"),"equipment cannot be taken from another layer")
	s.expedition.crowns=100
	var initial:=int(s.expedition.crowns)
	check(Economy.purchase(s,"trail_ration"),"ordinary finite purchase succeeds")
	var paid:=int(s.expedition.crowns)
	check(paid<initial and s.expedition.purchases["0:trail_ration"]==1,"payment and finite stock recorded together")
	check(s.save_run("user://phone-repair-transaction.save"),"transaction fixture saves")
	var loaded=State.new(false)
	check(loaded.load_run("user://phone-repair-transaction.save"),"transaction fixture reloads")
	check(loaded.expedition.crowns==paid and loaded.expedition.purchases["0:trail_ration"]==1,"currency and stock survive reload")
	check(loaded.world_pickups.any(func(p):return String(p.id).begins_with("purchase_0:trail_ration_")),"uncollected purchased item survives reload")
	DirAccess.remove_absolute(ProjectSettings.globalize_path("user://phone-repair-transaction.save"))
func test_extra_collisions():
	var s=fixture(u_shapes())
	var before=target(s,Vector2(260,200),102)
	var beyond=target(s,Vector2(600,200),103)
	s._replace_enemy_actors([before,beyond])
	shot(s,Vector2(200,200),Vector2(400,0))
	s.projectiles[0].piercing=true
	s._update_projectiles(1)
	check(int(before.hp)<100 and int(beyond.hp)==100 and s.projectiles.is_empty(),"piercing shot hits before edge and expires before reentry actor")
	s=fixture(u_shapes())
	s.player_pos=Vector2(600,200)
	var source=target(s,Vector2(200,250),101)
	source.id=101
	s._replace_enemy_actors([source])
	shot(s,Vector2(200,200),Vector2(400,0),101)
	var hp: int=s.player_hp
	s._update_projectiles(1)
	check(s.player_hp==hp,"enemy shot cannot hit player beyond void")
	s=fixture(u_shapes())
	shot(s,Vector2(200,200),Vector2(400,0))
	s.projectiles[0].kind="firebomb"
	s._update_projectiles(1)
	check(s.hazards.size()==1 and s._point_on_floor(s.hazards[0].pos) and Vector2(s.hazards[0].pos).x<300,"firebomb lands at first floor boundary on valid floor")
	s=fixture([rect_shape(Rect2(100,100,900,600))])
	source=target(s,Vector2(200,450),101)
	source.id=101
	s._replace_enemy_actors([source])
	s._add_barrier({"pos":Vector2(400,300),"axis":Vector2.DOWN,"half_length":100,"thickness":10,"hp":10,"lowered":false,"source_id":101,"layer":"fixture"})
	shot(s,Vector2(200,300),Vector2(400,0),0,true)
	s._update_projectiles(1)
	check(s.projectiles.size()==1 and float(s.projectiles[0].elevation)>State.PROJECTILE_GROUND_ELEVATION,"high arcing shot still clears low interior barrier")
	s.projectiles.clear()
	shot(s,Vector2(200,300),Vector2(400,0))
	s._update_projectiles(1)
	check(s.projectiles.is_empty(),"grounded shot still blocked by interior barrier")
	s=fixture(u_shapes())
	check(s._move_player_advance(Vector2(200,200),Vector2(400,0),100).x<300,"body-passing Advance cannot cross void")
	s=fixture(u_shapes())
	s.player_pos=Vector2(200,200)
	s.player_gale_velocity=Vector2(400,0)
	s._update_gale_drift(1)
	check(s.player_pos.x<300,"Gale drift cannot cross void")
	s=fixture([{"kind":"circle","center":Vector2(300,300),"radius":200,"layer":"fixture","part_id":0}])
	s.player_pos=Vector2(430,430)
	check(s._actor_footprint_on_floor(s.player_pos,24),"legacy cardinal footprint near curved edge is valid")
	check(s._move_actor(s.player_pos,Vector2(-5,-5),24,0,true).distance_to(Vector2(300,300))<s.player_pos.distance_to(Vector2(300,300)),"existing edge footprint can recover inward without becoming stuck")
	check(s._move_actor(s.player_pos,Vector2(5,5),24,0,true)==s.player_pos,"inward recovery exception cannot deepen an existing edge overlap")
	s=fixture([rect_shape(Rect2(100,100,900,600))])
	var early_large=target(s,Vector2(310,200),102)
	early_large.radius=80.0
	var later_small=target(s,Vector2(260,200),103)
	later_small.radius=10.0
	s._replace_enemy_actors([early_large,later_small])
	shot(s,Vector2(200,200),Vector2(200,0))
	s._update_projectiles(1)
	check(int(early_large.hp)<100 and int(later_small.hp)==100,"first hit uses swept body entry rather than nearest center")
func run():
	if not OS.get_user_data_dir().contains(".runtime"): quit(2); return
	test_guards()
	test_extra_collisions()
	print("PHONE_REPAIR_GUARDS checks=%d failures=%d" % [checks,failures.size()])
	quit(1 if failures.size() else 0)
